meta {
  name: get setmeal page
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/admin/setmeal/page?name={{setmealName}}&page=1&pageSize=10
  body: none
  auth: inherit
}

script:post-response {
  bru.setEnvVar("setmealId", res.getBody().data.records[0].id);
}

assert {
  res.status: eq 200
  res.body.code: eq 1
  res.body.data.total: eq 1
  res.body.data.records[0].name: eq {{setmealName}}
  res.body.data.records[0].id: isDefined
}
