meta {
  name: get dish cola after update
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/admin/dish/{{dishColaId}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.code: eq 1
  res.body.msg: isNull
  res.body.data.id: eq {{dishColaId}}
  res.body.data.categoryId: eq 11
  res.body.data.name: eq {{dishColaName}}
  res.body.data.price: eq 5
  res.body.data.status: eq 1
  res.body.data.description: eq 冰镇百事可乐，分类：酒水饮料
  res.body.data.image: eq https://picsum.photos/301
  res.body.data.flavors: length 1
  res.body.data.flavors[0].name: eq 温度
  res.body.data.flavors[0].value: eq ["冰镇","常温"]
}
