meta {
  name: create dish cola
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/admin/dish
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

script:pre-request {
  bru.setEnvVar("dishColaName", "测试-可乐");
}

body:json {
  {
    "categoryId": 11,
    "name": "{{dishColaName}}",
    "price": 5.00,
    "status": 1,
    "description": "冰镇可乐，分类：酒水饮料",
    "image": "https://picsum.photos/301"
  }
}

assert {
  res.status: eq 200
  res.body.code: eq 1
  res.body.msg: isNull
  res.body.data: isNull
}
